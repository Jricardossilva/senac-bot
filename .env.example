# Copie para .env e preencha. Nunca versione o .env.
SENAC_HOST=127.0.0.1
SENAC_PORT=8000
SENAC_LOG_LEVEL=INFO
APP_ENV=development
# simulation (padrão) ou physical. O modo físico (LEGO SPIKE Prime) ainda não existe: cai no simulador com aviso.
ROBOT_MODE=simulation

# Chave do Gemini (somente backend). Vazia = respostas programadas.
GEMINI_API_KEY=
# Consulte https://ai.google.dev/gemini-api/docs/models (modelos antigos são descontinuados)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=10
GEMINI_MAX_RETRIES=1

# Pasta da base de conhecimento institucional (JSON). Relativa à raiz do projeto.
KNOWLEDGE_DIR=knowledge
# Gerenciador de Eventos: pasta dos eventos, pesquisa externa (Gemini com busca) e atualização programada
EVENTS_DIR=events
EVENT_EXTERNAL_SEARCH=true
EVENT_AUTO_UPDATE=true

# Banco MySQL dos eventos e da programação de cursos (ex.: Hostinger, acesso remoto). Vazio = arquivos locais (events/ e
# knowledge/extractions/), que NÃO persistem no Render.
# No Render, cadastre estas variáveis em Environment; nunca versione a senha.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SSL=false

# Acesso do operador: código exigido nas rotas /api/ do painel (obrigatório com APP_ENV=production; vazio = aberto só em desenvolvimento).
OPERATOR_TOKEN=
# Limite de mensagens do chat por cliente por minuto (0 desativa).
CHAT_RATE_PER_MINUTE=30
